# Which model provider to use: claude or gemini
LLM_PROVIDER=gemini

# Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any current Gemini model id from AI Studio; the "-latest" alias tracks Google's current Flash model
GEMINI_MODEL=gemini-flash-latest

# Claude: key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Any current model id: https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5

KOMMUN_CONFIG=config/kommun.yaml
DATA_DIR=data
